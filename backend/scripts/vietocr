#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path


def load_predictor(model_path):
    try:
        from vietocr.tool.config import Cfg
        from vietocr.tool.predictor import Predictor
    except ImportError as exc:
        raise SystemExit(f"VietOCR Python package is not installed: {exc}")

    config = Cfg.load_config_from_name("vgg_transformer")
    config["device"] = "cpu"
    if model_path:
        config["weights"] = model_path
    return Predictor(config)


def load_image(path):
    try:
        from PIL import Image
    except ImportError as exc:
        raise SystemExit(f"Pillow is not installed: {exc}")

    with Image.open(path) as image:
        return image.convert("RGB")


def main():
    parser = argparse.ArgumentParser(prog="vietocr")
    parser.add_argument("image", help="Path to the image file to OCR")
    parser.add_argument("--model", default="", help="Optional VietOCR model weights path")
    args = parser.parse_args()

    image_path = Path(args.image)
    if not image_path.is_file():
        raise SystemExit(f"Input image does not exist: {image_path}")
    if args.model and not Path(args.model).is_file():
        raise SystemExit(f"VietOCR model does not exist: {args.model}")

    predictor = load_predictor(args.model)
    text = predictor.predict(load_image(image_path))
    sys.stdout.write(text or "")


if __name__ == "__main__":
    main()
